# ── Runtime output ───────────────────────────────────────────────────────────
# Sessions write here. Nothing under these is source; nothing here is committed.
logs/
results/

# ── Datasets ─────────────────────────────────────────────────────────────────
# data/ IS tracked: the curated dataset (14 MB, 17 runs, checksummed) ships with
# the code so a clone reproduces the paper's numbers. It carries its own CC BY
# 4.0 licence — see data/LICENSE-DATA.md. Raw unparsed captures stay out.
data/**/*.raw

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.pytest-results/
.ruff_cache/
.coverage
htmlcov/

# ── Vision captures (regenerate with python/vision/capture_checkerboard.py) ──
python/vision/calib_images/
python/vision/calib_images_close/

# ── Arduino / PlatformIO ─────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.bin
*.hex
*.map

# ── LaTeX build artefacts (docs/design/) ─────────────────────────────────────
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.lof
*.lot
docs/design/*.log

# ── MATLAB ───────────────────────────────────────────────────────────────────
*.asv
*.mex*
slprj/

