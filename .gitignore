# ── Runtime output ───────────────────────────────────────────────────────────
# Sessions write here. Nothing under these is source; nothing here is committed.
logs/
results/

# ── Datasets ─────────────────────────────────────────────────────────────────
# data/ ships only its README; the curated dataset drop is distributed
# separately (see docs/datasets.md). This keeps a stray 300 MB log out of git.
data/*
!data/README.md
!data/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.pytest-results/
.ruff_cache/
.coverage
htmlcov/

# ── Vision captures (regenerate with python/vision/capture_checkerboard.py) ──
python/vision/calib_images/
python/vision/calib_images_close/

# ── Arduino / PlatformIO ─────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.bin
*.hex
*.map

# ── LaTeX build artefacts (docs/design/) ─────────────────────────────────────
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.lof
*.lot
docs/design/*.log

# ── MATLAB ───────────────────────────────────────────────────────────────────
*.asv
*.mex*
slprj/

# ── OS / editor / agents ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.claude/
